{
  "info": {
    "name": "FoodBridge API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api" },
    { "key": "access_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (Donor)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Donor\",\n  \"email\": \"testdonor@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"DONOR\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.accessToken) {",
                  "  pm.collectionVariables.set('access_token', res.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"donor@foodbridge.dev\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"<your_refresh_token>\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Food Listings",
      "item": [
        {
          "name": "Create Listing (Donor)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/food",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Rice and Dal - 15 portions" },
                { "key": "quantity", "value": "15" },
                { "key": "foodType", "value": "VEG" },
                { "key": "latitude", "value": "12.9716" },
                { "key": "longitude", "value": "77.5946" },
                { "key": "expiryTime", "value": "2026-04-02T18:00:00.000Z" }
              ]
            }
          }
        },
        {
          "name": "Get Nearby Listings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/food/nearby?lat=12.9716&lng=77.5946&radius=10",
              "query": [
                { "key": "lat", "value": "12.9716" },
                { "key": "lng", "value": "77.5946" },
                { "key": "radius", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Claim Food (NGO)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/food/<listing_id>/claim",
            "body": { "mode": "raw", "raw": "{\n  \"notes\": \"We can pick up by 5pm\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Deliveries",
      "item": [
        {
          "name": "Get Available Deliveries (Volunteer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/deliveries/available"
          }
        },
        {
          "name": "Accept Delivery",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/deliveries/<request_id>/accept"
          }
        },
        {
          "name": "Update Delivery Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/deliveries/<delivery_id>/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PICKED\",\n  \"currentLat\": 12.9716,\n  \"currentLng\": 77.5946\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Misc",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/notifications"
          }
        },
        {
          "name": "Get Cancelled Orders (NGO)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/cancelled-orders?lat=12.9716&lng=77.5946"
          }
        },
        {
          "name": "Submit Rating",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/ratings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toUserId\": \"<user_id>\",\n  \"deliveryId\": \"<delivery_id>\",\n  \"rating\": 5,\n  \"review\": \"Great volunteer!\"\n}"
            }
          }
        }
      ]
    }
  ]
}
